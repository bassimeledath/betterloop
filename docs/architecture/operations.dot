digraph architecture {
graph [bgcolor="#fffefd",pad="0.25",nodesep="0.35",ranksep="0.5",fontname="Arial"];
node [shape=box,style="rounded,filled",fillcolor="#f2edf6",color="#b5a0c0",fontname="Arial",fontsize=12,margin="0.16,0.12",fontcolor="#302536"];
edge [fontname="Arial",fontsize=10,color="#71507e",fontcolor="#65596b",arrowsize=0.7];
rankdir=TB;
 tick [label="Cron tick"];
 schedule [label="Schedule
One bounded state transition"];
 signup [label="Signup
Advance one pending enrollment"];
 questions [label="Questions
Queue reminders before question cutoff"];
 mail [label="Mail
Claim at most two queued messages"];
 exports [label="Exports
Advance bounded archive work"];
 cleanup [label="Cleanup
Expire records + remove unused objects"];
 health [label="D1 service_state
Record each stage result"];
 tick -> schedule -> signup -> questions -> mail -> exports -> cleanup;
 schedule -> health [style=dashed]; signup -> health [style=dashed];
 questions -> health [style=dashed];
 mail -> health [style=dashed]; exports -> health [style=dashed]; cleanup -> health [style=dashed];
 note [label="A failed stage does not stop later stages",shape=note];
 health -> note [style=dashed];
 
}