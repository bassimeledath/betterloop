{
  "name": "betterloop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:worker": "wrangler dev --config wrangler.local.jsonc --port 8787",
    "dev:email": "wrangler dev --config tests/fixtures/email-routing/wrangler.jsonc --port 8790 --ip 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "db:local": "wrangler d1 migrations apply DB --local --config wrangler.local.jsonc",
    "deploy": "npm run build && wrangler deploy",
    "format": "prettier --write src server shared tests e2e scripts public package.json wrangler*.jsonc tsconfig.json *config.ts",
    "format:check": "prettier --check src server shared tests e2e scripts public package.json wrangler*.jsonc tsconfig.json *config.ts",
    "backup": "node scripts/backup.mjs create",
    "backup:install": "node scripts/install-weekly-backup.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/nunito-sans": "^5.3.0",
    "@js-temporal/polyfill": "latest",
    "hono": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/workers-types": "latest",
    "@playwright/test": "^1.64.1",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "esbuild": "latest",
    "jsonc-parser": "^3.3.1",
    "miniflare": "^4.20260730.0",
    "prettier": "^3.9.10",
    "proper-lockfile": "^4.1.2",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest",
    "wrangler": "latest"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.5",
      "undici": "7.30.1"
    }
  }
}
